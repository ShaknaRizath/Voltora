# Copy this file to .env and fill it in.

# --- Required ---
MONGO_URI=mongodb://localhost:27017/voltora
JWT_SECRET=replace-with-a-long-random-string
PORT=5001

# --- Frontend origin(s) allowed to call this API (comma-separated). Also used for Stripe redirects. ---
CLIENT_URL=http://localhost:5173

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
# Without a real key, checkout returns a clear "payments aren't set up" message.
STRIPE_SECRET_KEY=sk_test_...
# Only needed if you forward webhooks with the Stripe CLI (the success page also confirms payments itself):
#   stripe listen --forward-to localhost:5001/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email for password-reset codes (optional in development) ---
# If these are empty, the code is printed in this server's console instead of being emailed.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Voltora <no-reply@example.com>

# --- Chat assistant (Groq, https://console.groq.com). Kept on the server so it is never public. ---
GROQ_API_KEY=

# --- Image storage in production (optional locally) ---
# Hosts like Render wipe the disk on restart, so store uploads on Cloudinary (free tier):
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Set to production when deployed (turns on proxy support, and email must then be configured)
NODE_ENV=development
