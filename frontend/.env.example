# Copy this file to .env and fill it in. Never commit the real .env.

# Where the backend API runs. Leave empty in development (defaults to http://localhost:5001).
# In production set it to your deployed backend, e.g. https://voltora-api.onrender.com
VITE_API_URL=

# Stripe publishable test key (safe to expose, starts with pk_test_)
VITE_STRIPE_PUBLISABLE_KEY=
